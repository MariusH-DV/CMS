# Konfiguration fuer "docker compose up" (wird automatisch aus .env im Repo-Root gelesen).
# Vor dem ersten Start kopieren: cp .env.example .env  -  und alle "change-me"-Werte ersetzen!

# --- PostgreSQL ---
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=cms

# --- Backend ---
# Langer, zufaelliger String zum Signieren der Login-Tokens, z.B. mit: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
# Erlaubte Frontend-Adresse(n), kommagetrennt
CORS_ORIGIN=http://localhost:5173
# Oeffentlich erreichbare API-Adresse (wird in Raspberry-Pi-Bereitstellungspaketen hinterlegt).
# In Produktion die echte Domain mit https:// eintragen, z.B. https://cms.beispiel.de/api
PUBLIC_API_URL=http://localhost:3000/api

# --- Erster System-Admin (wird beim Start automatisch angelegt, falls noch keiner existiert) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# --- Ports auf dem Host ---
BACKEND_PORT=3000
FRONTEND_PORT=5173

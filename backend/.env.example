# Datenbank
DATABASE_URL="postgresql://cms:cms@localhost:5432/cms?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Oeffentlich erreichbare API-Adresse, die in Raspberry-Pi-Bereitstellungspaketen hinterlegt wird
PUBLIC_API_URL="http://localhost:3000/api"

# Speicher (getrennte Ordnerstruktur je Mandant wird hier unterhalb angelegt)
STORAGE_ROOT="./storage/tenants"

# Erster System-Admin (wird beim Seed angelegt, falls noch keiner existiert)
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
